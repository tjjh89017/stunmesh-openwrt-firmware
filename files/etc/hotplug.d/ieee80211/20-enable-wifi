#!/bin/sh
# Runs after 10-wifi-detect has added this phy to /etc/config/wireless.
# A freshly generated wifi-iface carries the stock SSID "OpenWrt", so
# that SSID is the one-shot marker: rename it, enable it and its radio
# (OpenWrt 25.12 sets disabled on the wifi-iface, older on the radio), and
# name the host "<MODEL>-<xxx>" (board name after the vendor prefix in
# upper case, last three hex digits of this phy's MAC in lower case).
# A user's later change to the SSID or the radio is never touched.

[ "$ACTION" = "add" ] || exit 0

. /lib/functions.sh

model="$(board_name | sed 's/^[^,]*,//' | tr 'a-z' 'A-Z')"
suffix="$(cat "/sys/class/ieee80211/$DEVICENAME/macaddress" 2>/dev/null | tr -d ':' | tail -c 4 | tr 'A-Z' 'a-z')"
[ -n "$model" ] && [ -n "$suffix" ] || exit 0
name="$model-$suffix"

changed=0
for iface in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
	[ "$(uci -q get "wireless.$iface.ssid")" = "OpenWrt" ] || continue
	radio="$(uci -q get "wireless.$iface.device")"
	uci set "wireless.$iface.ssid=$name"
	uci set "wireless.$iface.disabled=0"
	[ -n "$radio" ] && uci set "wireless.$radio.disabled=0"
	changed=1
done
[ "$changed" = 1 ] || exit 0
uci commit wireless

if [ "$(uci -q get system.@system[0].hostname)" = "OpenWrt" ]; then
	uci set system.@system[0].hostname="$name"
	uci commit system
	echo "$name" > /proc/sys/kernel/hostname
fi

ubus -t 5 list network.wireless >/dev/null 2>&1 && /sbin/wifi reload

exit 0
