#!/bin/sh
# /etc/init.d/boot generates /etc/config/wireless before it runs the
# uci-defaults, so every radio is already present here. A fresh
# wifi-iface carries the stock SSID "OpenWrt": rename it to
# "<MODEL>-<xxx>" (board name after the vendor prefix in upper case,
# last three hex digits of the phy0 MAC in lower case), enable it and
# its radio, and give the host the same name. OpenWrt 25.12 puts
# "disabled" on the wifi-iface, older releases on the radio.

. /lib/functions.sh

model="$(board_name | sed 's/^[^,]*,//' | tr 'a-z' 'A-Z')"
suffix="$(cat /sys/class/ieee80211/phy0/macaddress 2>/dev/null | tr -d ':' | tail -c 4 | tr 'A-Z' 'a-z')"
[ -n "$model" ] && [ -n "$suffix" ] || exit 0
name="$model-$suffix"

for iface in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
	[ "$(uci -q get "wireless.$iface.ssid")" = "OpenWrt" ] || continue
	radio="$(uci -q get "wireless.$iface.device")"
	uci set "wireless.$iface.ssid=$name"
	uci set "wireless.$iface.disabled=0"
	[ -n "$radio" ] && uci set "wireless.$radio.disabled=0"
done
uci commit wireless

if [ "$(uci -q get system.@system[0].hostname)" = "OpenWrt" ]; then
	uci set system.@system[0].hostname="$name"
	uci commit system
	echo "$name" > /proc/sys/kernel/hostname
fi

exit 0
