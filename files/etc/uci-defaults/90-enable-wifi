#!/bin/sh
# OpenWrt 25.12 puts "disabled" on the wifi-iface, older releases on the radio.

[ -e /etc/config/wifi-setup ] && exit 0
touch /etc/config/wifi-setup

. /lib/functions.sh

model="$(board_name | sed 's/^[^,]*,//' | tr 'a-z' 'A-Z')"
suffix="$(cat /sys/class/ieee80211/phy0/macaddress 2>/dev/null | tr -d ':' | tail -c 4 | tr 'A-Z' 'a-z')"
[ -n "$model" ] && [ -n "$suffix" ] || exit 0
name="$model-$suffix"

for iface in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
	radio="$(uci -q get "wireless.$iface.device")"
	uci set "wireless.$iface.ssid=$name"
	uci set "wireless.$iface.disabled=0"
	[ -n "$radio" ] && uci set "wireless.$radio.disabled=0"
done
uci commit wireless

exit 0
