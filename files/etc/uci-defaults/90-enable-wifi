#!/bin/sh
# First-boot Wi-Fi setup. /etc/init.d/boot generates
# /etc/config/wireless before it runs the uci-defaults, so every
# radio is already present here.
#
# /etc/config/stunmesh-firmware is the one-shot marker. sysupgrade
# backs up /etc/config, so a kept config carries the marker and is
# left alone; "sysupgrade -n" and firstboot drop it and get a fresh
# setup. The marker does not depend on the hostname or SSID values.
#
# Name: "<MODEL>-<xxx>", board name after the vendor prefix in upper
# case, last three hex digits of the phy0 MAC in lower case. OpenWrt
# 25.12 puts "disabled" on the wifi-iface, older releases on the radio.

[ "$(uci -q get stunmesh-firmware.firstboot.done)" = "1" ] && exit 0

. /lib/functions.sh

model="$(board_name | sed 's/^[^,]*,//' | tr 'a-z' 'A-Z')"
suffix="$(cat /sys/class/ieee80211/phy0/macaddress 2>/dev/null | tr -d ':' | tail -c 4 | tr 'A-Z' 'a-z')"
[ -n "$model" ] && [ -n "$suffix" ] || exit 0
name="$model-$suffix"

for iface in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
	radio="$(uci -q get "wireless.$iface.device")"
	uci set "wireless.$iface.ssid=$name"
	uci set "wireless.$iface.disabled=0"
	[ -n "$radio" ] && uci set "wireless.$radio.disabled=0"
done
uci commit wireless

uci set system.@system[0].hostname="$name"
uci commit system
echo "$name" > /proc/sys/kernel/hostname

touch /etc/config/stunmesh-firmware
uci set stunmesh-firmware.firstboot=setup
uci set stunmesh-firmware.firstboot.done=1
uci commit stunmesh-firmware

exit 0
