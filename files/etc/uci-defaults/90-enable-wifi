#!/bin/sh
# Stock OpenWrt writes every radio with disabled='1' on first boot
# and names the host "OpenWrt". Enable each radio and give the host
# and the SSID one name: "<MODEL>-<xxx>", where MODEL is the board
# name after the vendor prefix, in upper case, and xxx is the last
# three hex digits of the wifi MAC, in lower case. This matches the
# vendor's own default SSID scheme, so the sticker still identifies
# the device.

. /lib/functions.sh

# Generate /etc/config/wireless if the hotplug detection has not
# run yet, so the loop below sees every radio.
[ -n "$(uci -q show wireless | grep '=wifi-device$')" ] || wifi config

model="$(board_name | sed 's/^[^,]*,//' | tr 'a-z' 'A-Z')"
suffix="$(cat /sys/class/ieee80211/phy0/macaddress 2>/dev/null | tr -d ':' | tail -c 4 | tr 'A-Z' 'a-z')"

if [ -n "$model" ] && [ -n "$suffix" ]; then
	name="$model-$suffix"
	uci set system.@system[0].hostname="$name"
	uci commit system
	echo "$name" > /proc/sys/kernel/hostname
	for iface in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
		uci set "wireless.$iface.ssid=$name"
	done
fi

for radio in $(uci -q show wireless | sed -n 's/^wireless\.\(radio[0-9]*\)=wifi-device$/\1/p'); do
	uci set "wireless.$radio.disabled=0"
done
uci commit wireless

exit 0
